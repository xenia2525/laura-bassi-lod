lb:voltaire_quote a schema:Quotation ;
    rdfs:label "Quotation: There is no Bassi in London, and I would be much happier to…"@en ;
    dcterms:creator lb:voltaire ;
    schema:about lb:laura_bassi ;
    schema:text "There is no Bassi in London, and I would be much happier to be added to your Academy of Bologna than that of the English, even though it has produced a Newton"@en .

